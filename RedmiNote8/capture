#!/system/bin/sh
# Take a photo with the stock camera and print its absolute path.
# Run as root:  su -c capture

DIR=/storage/emulated/0/DCIM/Camera

input keyevent 224                          # wake
wm dismiss-keyguard                         # else the shutter goes to the lockscreen

am start -a android.media.action.STILL_IMAGE_CAMERA >/dev/null
until dumpsys window | grep -q 'mCurrentFocus.*com.android.camera'; do sleep 0.2; done
sleep 1                                     # let the preview expose

last=$(ls "$DIR"/IMG_* | tail -1)
input keyevent 27                           # shutter
until [ "$(ls "$DIR"/IMG_* | tail -1)" != "$last" ]; do sleep 0.2; done
new=$(ls "$DIR"/IMG_* | tail -1)

# The full image lands just after a ~130KB EXIF/thumbnail stub; let the size settle.
size=0
until [ "$(stat -c %s "$new")" = "$size" ]; do
    size=$(stat -c %s "$new")
    sleep 1
done

echo "$new"
input keyevent 26                           # screen off
